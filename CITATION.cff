    given-names: G.
version: 0.7.1
date-released: "2026-08-01"
license: CC-BY-4.0
url: "https://ai-sovereignty.vercel.app"
repository: "https://github.com/galexandrov11/ai-saf"
keywords:
  - AI sovereignty
  - strategic autonomy
  - technology policy
